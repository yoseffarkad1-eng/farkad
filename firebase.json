{
  "functions": [{
    "source": "functions",
    "codebase": "reminders",
    "ignore": ["node_modules", ".git", "*-debug.log", ".secret.local", ".env*"]
  }],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": false
    }
  }
}
