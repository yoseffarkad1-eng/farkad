+
+/* ---------------------------------------------------------------- the ⋯ sheet */
+.more-content { padding: 8px 12px calc(12px + var(--safe-bottom)); }
+.more-grip { width: 40px; height: 5px; border-radius: 3px; background: var(--line); margin: 2px auto 10px; }
