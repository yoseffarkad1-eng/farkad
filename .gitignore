node_modules/

# Firebase emulator output. Written into the working tree by `firebase
# emulators:exec`, and one of these was committed once already.
firestore-debug.log
firebase-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log
*-debug.log
.firebase/

# Playwright
test-results/
playwright-report/

# Written and deleted by tests/cas.emulator.test.mjs while it runs.
js/sync/_adapter-under-test.mjs
js/sync/_adapter-test-config.mjs
js/sync/_adapter-bootstrap-test.mjs
js/sync/_bootstrap-test-config.mjs
js/sync/_adapter-money-test.mjs
