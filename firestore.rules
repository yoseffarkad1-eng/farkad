rules_version = '2';

// The real access control for this app. The web config in js/sync/firebase-config.js is
// public and protects nothing; these rules are enforced on the server and are the only
// thing standing between the schedule and anyone who finds the URL.
//
// Everyone listed writes. The evening roster is built by the three of them together and
// they divide the work between themselves, so there is deliberately no reader/writer
// split here - the protection against overwriting each other is technical, not a
// permission: the client sends one field path per edit, never the whole document.
//
// Deployment: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Put the real addresses here. Anyone not listed is refused even with a valid Google
    // account - public sign-up is closed on purpose.
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        'yosef.farkad1@gmail.com',
        'farkad1963@gmail.com',
        'mu.mahameed1992@gmail.com'
        // A fourth goes here the same way: comma on the line above, address below, then
        // Publish in the console. Lower case - the token's email arrives lower-cased and
        // an address with a capital in it would match nobody.
      ];
    }

    // Guards the shape of a full replacement (import, backup restore). A field-level
    // edit is exempt because it carries only the one path it changed - requiring the top
    // level keys there would reject every normal write.
    function fullDocumentOk() {
      return request.resource.data.keys().hasAll(['workers', 'places', 'updatedAt'])
        && request.resource.data.workers is list
        && request.resource.data.places is list;
    }

    function isFullReplacement() {
      return request.resource.data.keys().hasAny(['workers', 'places']);
    }

    // Every write must carry a timestamp: the client's merge rule depends on it, and a
    // write without one would make the document look older than it is.
    function stamped() {
      return request.resource.data.updatedAt is string;
    }

    // ---------------------------------------------------------------- the ordering
    //
    // Three phones share this document. Firestore merges disjoint field paths server-side,
    // which is what lets two people fill in the same evening at once - but everything that
    // is NOT a disjoint merge had no ordering at all: a restore raced an edit and the loser
    // was silent, a stale writer overwrote a newer document, and a request that might still
    // land was treated as dead and sent twice.
    //
    // The client's send claim cannot fix that. It is a lease in localStorage: it
    // coordinates tabs of one browser profile, and the three phones share no storage. The
    // only party all three can agree with is this file.
    //
    // Three fields carry it, and none of them is a clock. updatedAt stays exactly what it
    // was - a phone's own time, informational, never load-bearing.

    // The version of the protocol the writer speaks.
    //
    // This is the backward-compatibility decision, stated rather than finessed: a build
    // that predates the protocol writes no such field, and there is no rule that both
    // accepts those writes and orders them - accepting them once the document is ordered
    // IS the hole. So after cutover it is refused, the old build shows a visible sync
    // error, keeps its queue, does not say synced, and cannot diverge quietly.
    //
    // Cutover is not a date somebody picks. It is the first protocol write landing on the
    // document; until then legacyWrite() below keeps the un-updated phone working. That is
    // what makes the rollout executable rather than a sentence. See docs/sync-protocol.md.
    function versioned() {
      return request.resource.data.protocol is int
        && request.resource.data.protocol >= 1;
    }

    // The compare-and-set. Exactly one more than what is there.
    //
    // Two phones that both read revision 5 both try to write 6. The first lands; for the
    // second, the document now says 6, its write still says 6, and 6 is not 6 + 1 - so it
    // is refused instead of silently overwriting work that is already there. The client
    // turns that refusal into a held conflict rather than a retry that would overwrite.
    function nextRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
    }

    function firstRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == 1;
    }

    // THE DOCUMENT THAT IS ALREADY THERE, and has never spoken the protocol.
    //
    // The live schedule was written by builds that had never heard of a revision. It has
    // a roster, days and advances and no `revision` field at all - so nextRevision()
    // asks it for `null + 1` and refuses, for ever. Without an exception the existing
    // document could never take its first protocol write, and the rollout is a paragraph
    // that cannot be executed.
    function noRevisionYet() {
      return !('revision' in resource.data);
    }

    // The exception is exactly one write wide. It applies only while the document has no
    // revision; the moment one lands, noRevisionYet() is false and nextRevision() governs
    // everything after. A later write claiming revision 1 over a document already at 7 is
    // refused by both halves, so this cannot be reused to reset the count.
    function bootstrapRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == 1;
    }

    // AND IT MAY NOT CARRY ONE BYTE OF WORK.
    //
    // The five fields the production bootstrap actually writes - see the
    // transaction.update in js/sync/firebase-adapter.js - and nothing else. Measured
    // before this line existed: an ordinary allowed user could take the legacy document
    // to revision 1 and, in the same accepted write, delete every day worked, alter a
    // stamped daily rate, delete the advances, forge a ledger entry, erase the roster,
    // change schemaVersion, or add a field nobody has heard of. Seventeen of nineteen
    // such writes were accepted. The two that were refused were refused by accident.
    //
    // This is the ONE accepted write with no compare-and-set behind it: there is no prior
    // revision to check it against, so a stale bootstrap sent from a phone that has been
    // away can carry its own idea of the document over another phone's newer legacy
    // correction, and nothing else in this file would refuse it. The ordinary
    // nextRevision() branch does not need this - a whole-document write there is the
    // restore, it is guarded by fullDocumentOk(), and its revision has to be exactly one
    // past what is on the server.
    //
    // affectedKeys() is the right question rather than listing the business fields: a
    // build that adds a field this rule has never heard of must not thereby open a hole
    // in it. Anything outside the five is business, whatever it is called.
    function bootstrapTouchesOnlyProtocol() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['protocol', 'revision', 'lastOpId', 'updatedAt', 'updatedBy']);
    }

    // A WRITE FROM A PHONE THAT HAS NOT UPDATED YET.
    //
    // This is what makes the rollout executable rather than a sequencing puzzle with no
    // valid order. Publishing rules that demand a protocol breaks every phone in the
    // field the same minute; waiting until every phone has updated means the updated ones
    // cannot write in the meantime, because the published rules have no receipts
    // subcollection. Neither order works.
    //
    // So during the transition both shapes are allowed - and only until the document is
    // bootstrapped. Once it carries a revision, a write with no protocol is refused, so
    // an old phone cannot flatten the ordering fields after cutover. That is the whole
    // rollout: publish this, let the phones update, and the first protocol-capable write
    // closes the door behind itself.
    function legacyWrite() {
      return noRevisionYet() && !('protocol' in request.resource.data);
    }

    // The operation this write carries, and its receipt - which must exist AFTER this
    // commit. getAfter() is the whole of the atomicity guarantee: the rule can only be
    // satisfied if the document and the receipt land together, so a reader never sees a
    // revision without the receipt that explains it, or a receipt for a revision that was
    // never applied.
    //
    // The receipt is also what makes a retry safe. A request that may still land can be
    // sent again, because the second attempt finds its own receipt and stops - which is
    // the difference between "sent twice" and "acknowledged once".
    // THE OTHER HALF OF THE PAIR, read from the receipt's side.
    //
    // carriesReceipt() asks, of a schedule write, "is the receipt there afterwards".
    // This asks, of a receipt write, "is the schedule pointing at me afterwards" - the
    // same single commit, checked from both ends, so neither half can land without the
    // other whichever one the client sends first.
    //
    // Three things, and each of them is load-bearing. The schedule must exist, or this is
    // a receipt for a document that is not there. Its lastOpId must be THIS operation, or
    // the receipt is naming somebody else's write. And its revision must equal the
    // revision the receipt claims, or a retry that finds this receipt is told the
    // operation landed at a revision it did not.
    // NOT exists(). That reads the state BEFORE this commit, and the commonest legitimate
    // pair is the very first write of a document: the schedule is created and its receipt
    // beside it, in one transaction, and before that transaction there is no schedule at
    // all. An exists() here refused every create - the first write of every new project.
    //
    // getAfter alone is the whole test. If the schedule does not exist afterwards there is
    // nothing to read a field from, the rule errors, and the write is denied - which is
    // exactly the answer an orphan receipt deserves.
    // AND WHAT THE OPERATION DID, not only when it landed.
    //
    // A revision says a write wearing this name reached this point. It does not say what
    // that write was, and the client is built to BELIEVE a receipt - that is what makes a
    // retry safe - so a second arrival carrying the same name and a different path and
    // value was answered "already applied", acknowledged, pruned and reported synced,
    // with the phone holding one value and the cloud another.
    //
    // WHAT THESE RULES CAN AND CANNOT DO, said plainly because the difference matters.
    // They can require the fingerprint to be present and well-formed, require the schedule
    // and the receipt to carry the SAME one, and - because getAfter() makes the pair a
    // single commit and receipts are immutable - make that first pairing binding for ever,
    // so a name can never afterwards be re-pointed at different semantics. They cannot
    // recompute it: there is no canonical serializer here, no loops, .keys() reaches only
    // the top level, and on an update request.resource.data is the MERGED document, so the
    // rules cannot even enumerate which nested paths this write touched. The fingerprint
    // is therefore made trustworthy against loss and tampering by the server, and made to
    // MEAN something by the client - which is also the only place the replay can be
    // refused, because a replay performs no write and never reaches these rules.
    // The bootstrap's own pairing: the same single commit, without the fingerprint the
    // bootstrap has nothing to put in.
    function bootstrapReceipt(docId) {
      return request.resource.data.lastOpId is string
        && request.resource.data.lastOpId.size() > 0
        && request.resource.data.lastOpId.size() < 128
        && getAfter(/databases/$(database)/documents/schedules/$(docId)/receipts/$(request.resource.data.lastOpId)).data.revision
             == request.resource.data.revision;
    }

    function boundFingerprint() {
      return request.resource.data.opFingerprint is string
        && request.resource.data.opFingerprint.size() > 0
        && request.resource.data.opFingerprint.size() < 128;
    }

    function receiptMatchesSchedule(docId, opId) {
      let after = getAfter(/databases/$(database)/documents/schedules/$(docId)).data;
      return after.lastOpId == opId
        && after.revision == request.resource.data.revision
        // The bootstrap has no fingerprint on either side - its five protocol fields ARE
        // the operation - so the pair is required to AGREE about that rather than to
        // carry one. A receipt with a fingerprint for a schedule without one, or the
        // reverse, is a mismatched pair and refused.
        && (('opFingerprint' in after)
            ? (('opFingerprint' in request.resource.data)
                && after.opFingerprint == request.resource.data.opFingerprint)
            : !('opFingerprint' in request.resource.data));
    }

    function carriesReceipt(docId) {
      let receipt = getAfter(/databases/$(database)/documents/schedules/$(docId)/receipts/$(request.resource.data.lastOpId)).data;
      return request.resource.data.lastOpId is string
        && request.resource.data.lastOpId.size() > 0
        && request.resource.data.lastOpId.size() < 128
        && boundFingerprint()
        && receipt.revision == request.resource.data.revision
        && receipt.opFingerprint == request.resource.data.opFingerprint;
    }

    // ---------------------------------------------------------------- the pay book
    //
    // `pay` is the map that says whether a man was paid: closures, payments, voids. Until
    // v175 these rules looked at who wrote, at the envelope and at the receipt, and at
    // nothing inside the document - so, measured on the emulator with the rules as they
    // stood (tests/paybook.emulator.test.mjs, v173): an account on the list could REWRITE
    // a pay entry, DELETE one, and write a whole document with no `pay` at all. A build
    // from before the pay book does the third without meaning to: it has never heard of
    // the map, drops it from its own copy, and its restore then erases it from the cloud
    // for all three phones (measured on v167, v169 and v171).
    //
    // Three rules close that, and they bind only a write that TOUCHES the map - a phone
    // that has not updated goes on recording days exactly as before, because a field-path
    // update of a day leaves `pay` as it was:
    //
    //   1. the writer speaks protocol 2. A build that predates the pay book speaks 1, so
    //      whatever it sends that would change the map - which can only be a whole
    //      document without it - is refused, loudly, with its work still on the phone;
    //   2. the map only grows: no entry removed, no entry changed. Append-only on the
    //      server, where no version of the client can break it;
    //   3. the write creates, IN THE SAME COMMIT, the document under closed/ that it
    //      names - a create-once copy of what it adds. See match /closed below.
    //
    // An absent map and an empty one are the same thing here, deliberately. This build
    // writes `pay: {}` in a whole document and an older one writes none; calling that a
    // touch would refuse every older build's restore the moment a newer one had written,
    // for a difference that holds nobody's money.
    function payBefore() {
      return resource.data.get('pay', {});
    }

    function payAfter() {
      return request.resource.data.get('pay', {});
    }

    function touchesPay() {
      return payAfter() != payBefore();
    }

    function speaksPaybook() {
      return request.resource.data.protocol is int
        && request.resource.data.protocol >= 2;
    }

    function payOnlyGrows() {
      return payAfter().diff(payBefore()).removedKeys().size() == 0
        && payAfter().diff(payBefore()).changedKeys().size() == 0;
    }

    // The closed document this write names, as it stands AFTER this commit: it must be
    // there, and it must say it was written by this very operation at this very revision.
    // getAfter is what says "together" - the same device carriesReceipt uses - so a pay
    // entry cannot land in the schedule without its create-once copy, and (from the other
    // side, closedMatchesSchedule) a copy cannot be created without the schedule write.
    function carriesClosed(docId) {
      let closed = getAfter(/databases/$(database)/documents/schedules/$(docId)/closed/$(request.resource.data.closedId)).data;
      return request.resource.data.closedId is string
        && request.resource.data.closedId.size() > 0
        && request.resource.data.closedId.size() < 128
        && closed.opId == request.resource.data.lastOpId
        && closed.revision == request.resource.data.revision;
    }

    // ---------------------------------------------------------------- what has left
    //
    // A settled closure leaves this document for its closed copy, and one row of
    // `payIndex.rows` stays in its place (docs/payroll-closure.md, Phase 5). The row is
    // the only thing in this document that says those entries exist at all, so it is
    // guarded the way the entries were:
    //
    //   1. the index only grows. No row is removed and none is changed, by anybody. A
    //      whole document written by a build that has never heard of the index carries
    //      none - and is refused, with that phone's work still on the phone;
    //   2. a row arrives one at a time, in a write that NAMES it (`archivedId`), speaks
    //      protocol 2, and whose closed document of that name ALREADY EXISTS. exists(),
    //      not getAfter: the copy is made and read back first, in a commit of its own,
    //      and only then may anything leave;
    //   3. pay entries may leave this document in such a write and in no other - and
    //      such a write adds no pay entry and changes none.
    //
    // WHAT THESE RULES CANNOT DO, said plainly as above: they cannot check that the
    // entries leaving are the ones the closed documents hold. There are no loops here and
    // an update shows the merged document. That comparison is the client's, made inside
    // the transaction that drops them (archiveClosed in js/sync/firebase-adapter.js),
    // and it is measured in tests/paybook.archive.emulator.test.mjs.
    function indexBefore() {
      return resource.data.get('payIndex', {}).get('rows', {});
    }

    function indexAfter() {
      return request.resource.data.get('payIndex', {}).get('rows', {});
    }

    function touchesIndex() {
      return indexAfter() != indexBefore();
    }

    function archivesOne(docId) {
      return speaksPaybook()
        && request.resource.data.archivedId is string
        && request.resource.data.archivedId.size() > 0
        && request.resource.data.archivedId.size() < 128
        && indexAfter().diff(indexBefore()).removedKeys().size() == 0
        && indexAfter().diff(indexBefore()).changedKeys().size() == 0
        && indexAfter().diff(indexBefore()).addedKeys().hasOnly([request.resource.data.archivedId])
        && indexAfter().diff(indexBefore()).addedKeys().size() == 1
        && exists(/databases/$(database)/documents/schedules/$(docId)/closed/$(request.resource.data.archivedId));
    }

    function payOnlyLeaves() {
      return payAfter().diff(payBefore()).addedKeys().size() == 0
        && payAfter().diff(payBefore()).changedKeys().size() == 0;
    }

    function indexGuard(docId) {
      return !touchesIndex() || archivesOne(docId);
    }

    // A PHONE THAT DOES NOT KEEP THE PAY BOOK MAY NOT WRITE OVER AN INDEX.
    //
    // Once a closure has left this document, a build from before the pay book that is
    // installed afresh reads that period as never closed and its advances as never
    // deducted - and would let somebody close it again, the old way, through a field
    // path these rules do not look inside. Its screens cannot be made right from here;
    // its writes can be stopped. A build that has been syncing all along still holds the
    // entries (the ledger is merged by union) - but nothing here can tell the two apart,
    // and the rollout rule already says every phone updates before the first closure.
    function indexedNeedsPaybook() {
      return indexBefore().size() == 0 || speaksPaybook();
    }

    // ONCE THE PAY BOOK IS ON, ONLY A BUILD THAT KEEPS IT WRITES AT ALL (Phase 8).
    //
    // A record is turned on by its first pay entry - the opening (docs/payroll-
    // activation.md). From that write on, every phone that holds the record reads a
    // man's advance debt under the one-debt ruling and closes accounts through the pay
    // book. A build from before the pay book does neither: it would go on showing the
    // old arithmetic, and - the part that matters here - it could still close an account
    // the old way, with no signal, through field paths these rules do not look inside,
    // and send it later. Its screens cannot be made right from here; its writes can be
    // stopped, and a phone whose every write is refused says so and is not «מסונכרן».
    // Such a build speaks protocol 1 (v184 and everything before it); every build that
    // keeps the pay book speaks 2. With no pay book on the document this is vacuous,
    // which is what makes publishing these rules BEFORE any phone updates safe
    // (measured: tests/activation.emulator.test.mjs).
    function activatedNeedsPaybook() {
      return payBefore().size() == 0 || speaksPaybook();
    }

    function payGuard(docId) {
      return !touchesPay()
        || (speaksPaybook() && payOnlyGrows() && carriesClosed(docId))
        || (payOnlyLeaves() && touchesIndex() && archivesOne(docId));
    }

    // ---------------------------------------------------------------- months that have left
    //
    // A closed month of days leaves this document for a document of its own under
    // months/, and `monthIndex` stays in its place: one row per month, and the calendar
    // dates of those months as one flat list (docs/payroll-closure.md, Phase 6). The
    // list is here for these rules and for nothing else - there are no loops in this
    // language and no way to take the month out of a date inside a set, but two sets can
    // be asked whether they meet.
    //
    //   1. NO WRITE, BY ANYBODY, OF ANY SHAPE, adds, changes or removes a day whose date
    //      is in the list (daysGuard). That is what refuses a whole document that would
    //      put an archived day back, and a queued edit from a phone that had not heard.
    //      The one write that removes such days is the write that archives them - and it
    //      is judged against the list as it stood BEFORE, which does not yet hold them;
    //   2. the index only grows: no row removed or changed, no date removed;
    //   3. a row arrives one at a time, in a write that names the month and its month
    //      document, speaks protocol 2, and whose month document ALREADY EXISTS, is of
    //      that month, and carries the digest the row carries. The dates added are that
    //      document's dates. AND THE DAYS THAT LEAVE ARE EXACTLY THE DAYS IT HOLDS, key
    //      for key - nothing leaves that the copy lacks, nothing stays that it has;
    //   4. once a month has left, a writer that does not speak protocol 2 may not write
    //      at all: a build from before this, installed afresh, reads those months as
    //      empty, and its screens cannot be made right from here.
    //
    // WHAT THESE RULES CANNOT DO, said plainly: compare the VALUE of each day leaving
    // with the copy's, or check that every date in a month document belongs to its
    // month. Both are the client's, made inside the transaction that drops them
    // (archiveMonth in js/sync/firebase-adapter.js) and measured in
    // tests/months.emulator.test.mjs.
    function monthRowsBefore() {
      return resource.data.get('monthIndex', {}).get('rows', {});
    }

    function monthRowsAfter() {
      return request.resource.data.get('monthIndex', {}).get('rows', {});
    }

    function monthDatesBefore() {
      return resource.data.get('monthIndex', {}).get('dates', []);
    }

    function monthDatesAfter() {
      return request.resource.data.get('monthIndex', {}).get('dates', []);
    }

    function daysBefore() {
      return resource.data.get('days', {});
    }

    function daysAfter() {
      return request.resource.data.get('days', {});
    }

    function touchesMonths() {
      return monthRowsAfter() != monthRowsBefore()
        || monthDatesAfter() != monthDatesBefore();
    }

    function daysGuard() {
      return monthDatesBefore().size() == 0
        || !daysAfter().diff(daysBefore()).affectedKeys().hasAny(monthDatesBefore());
    }

    function archivesMonth(docId) {
      let month = request.resource.data.archivedMonth;
      let copy = get(/databases/$(database)/documents/schedules/$(docId)/months/$(request.resource.data.monthDoc)).data;
      let rows = monthRowsAfter().diff(monthRowsBefore());
      let days = daysAfter().diff(daysBefore());
      return speaksPaybook()
        && month is string
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.monthDoc is string
        && rows.removedKeys().size() == 0
        && rows.changedKeys().size() == 0
        && rows.addedKeys().hasOnly([month])
        && rows.addedKeys().size() == 1
        && monthRowsAfter()[month].d == request.resource.data.monthDoc
        && monthRowsAfter()[month].h == copy.digest
        && copy.month == month
        && monthDatesAfter().size() == monthDatesBefore().size() + copy.dates.size()
        && monthDatesAfter().toSet().hasAll(monthDatesBefore())
        && monthDatesAfter().toSet().hasAll(copy.dates)
        && !monthDatesBefore().toSet().hasAny(copy.dates)
        && days.addedKeys().size() == 0
        && days.changedKeys().size() == 0
        && days.removedKeys() == copy.days.keys().toSet();
    }

    function monthGuard(docId) {
      return !touchesMonths() || archivesMonth(docId);
    }

    function monthsNeedPaybook() {
      return (monthRowsBefore().size() == 0 && monthDatesBefore().size() == 0)
        || speaksPaybook();
    }

    // A project may not begin with a month index either: a row stands for a month
    // document, and a project that does not exist yet has none.
    function monthGuardOnCreate() {
      return request.resource.data.get('monthIndex', {}).get('rows', {}).size() == 0
        && request.resource.data.get('monthIndex', {}).get('dates', []).size() == 0;
    }

    // The first write of a project has nothing to compare against. It may carry a pay
    // book only on the same terms: protocol 2, and its closed copy beside it.
    function payGuardOnCreate(docId) {
      return payAfter().size() == 0
        || (speaksPaybook() && carriesClosed(docId));
    }

    // And it may not begin with an index: a row stands for closed documents, and a
    // project that does not exist yet has none.
    function indexGuardOnCreate() {
      return request.resource.data.get('payIndex', {}).get('rows', {}).size() == 0;
    }

    // AND THE SCHEDULE MUST MOVE IN THIS COMMIT. Measured before the last line existed:
    // the schedule stays pointing at its latest operation until the next write, so a
    // closed document naming THAT operation and revision satisfied the first three lines
    // with no schedule write anywhere near it - a second "closure" hung on an operation
    // that never created it. The revision before this commit has to be exactly one less
    // than the revision the closed document claims, which is true only of the commit
    // that takes the schedule there. A schedule that does not exist yet is the first
    // write of a project, and counts as revision nothing.
    function closedMatchesSchedule(docId) {
      let after = getAfter(/databases/$(database)/documents/schedules/$(docId)).data;
      return after.lastOpId == request.resource.data.opId
        && after.revision == request.resource.data.revision
        && after.protocol >= 2
        && (!exists(/databases/$(database)/documents/schedules/$(docId))
            || get(/databases/$(database)/documents/schedules/$(docId)).data.get('revision', 0)
                 == request.resource.data.revision - 1);
    }

    match /schedules/{docId} {
      allow read: if allowed();

      allow create: if allowed()
        && stamped()
        && versioned()
        && firstRevision()
        && carriesReceipt(docId)
        && payGuardOnCreate(docId)
        && indexGuardOnCreate()
        && monthGuardOnCreate()
        && (!isFullReplacement() || fullDocumentOk());

      allow update: if allowed()
        && stamped()
        && (
          // A protocol write: the ordinary next revision, or the one bootstrap that
          // brings a legacy document into the protocol. Either way it carries its
          // receipt, so a revision never exists without the operation that explains it.
          (versioned() && nextRevision() && carriesReceipt(docId))
          // The bootstrap carries no business semantics to fingerprint - its five fields
          // ARE the whole operation, and adding a sixth would break the affected-key rule
          // that keeps it protocol-only. Its receipt is bound by revision alone.
          || (versioned() && noRevisionYet() && bootstrapRevision()
            && bootstrapTouchesOnlyProtocol() && bootstrapReceipt(docId))
          // Or a phone that has not updated yet, while the document is still legacy.
          || legacyWrite()
        )
        // Whichever branch let it in: nothing changes the pay book except a protocol-2
        // write that only adds to it and creates its closed copy in the same commit.
        && payGuard(docId)
        // And nothing changes the index of what has left except the one write that
        // archives one closure; and once there is an index, only a build that keeps
        // the pay book writes at all.
        && indexGuard(docId)
        && indexedNeedsPaybook()
        // And once the pay book is on at all, the same: only a build that keeps it writes.
        && activatedNeedsPaybook()
        // And the months that have left: nothing writes to one of their dates, nothing
        // changes their index except the one write that archives one month, and once
        // one has left only a build that knows of them writes at all.
        && daysGuard()
        && monthGuard(docId)
        && monthsNeedPaybook()
        && (!isFullReplacement() || fullDocumentOk());

      // Nothing deletes the schedule. It is the record of who worked where.
      allow delete: if false;

      // The receipts. Created with the write they belong to, and then frozen.
      //
      // Immutable on purpose: a receipt that could be changed or removed is a receipt that
      // cannot answer "did my operation already land", which is the one question a retry
      // has to ask. Readable, because that is how the retry asks it.
      //
      // AND NEVER ALONE. This rule used to require only that the receipt name an integer
      // revision of one or more, which let anyone on the list create
      //
      //   schedules/current/receipts/op_never_applied   { revision: 999 }
      //
      // without a schedule write anywhere near it. The client treats an existing receipt
      // as proof that its operation landed - that is the whole point of a receipt, and it
      // is what makes a retry safe - so a receipt for an operation that was never applied
      // is a lie the client is built to believe. It would find it, stop, acknowledge, and
      // prune the queue: an evening pruned off the phone on the strength of a record that
      // nothing wrote.
      //
      // So a receipt is only creatable together with the schedule write it names, and
      // getAfter is what says "together". After this commit the schedule must exist, must
      // be pointing at THIS operation, and must be at exactly the revision this receipt
      // claims. There is no order of writes that satisfies all three except the one that
      // applies the operation - which is what the receipt was always supposed to mean.
      match /receipts/{opId} {
        allow read: if allowed();
        allow create: if allowed()
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && receiptMatchesSchedule(docId, opId);
        allow update, delete: if false;
      }

      // CLOSED HISTORY: one document per closure, payment or correction, created once.
      //
      // The schedule is one document and Firestore refuses one over a mebibyte; closures
      // are what fill it (docs/payroll-closure.md, Capacity). So what a closure froze
      // lives here, in a document of its own - and here it is also something the pay
      // book has never had on the server: append-only. CREATE only. Not update, so a
      // frozen payslip can never be restated by a later state of anybody's phone; not
      // delete, so no tap and no bug in any build can lose one.
      //
      // AND NEVER ALONE, for the reason a receipt is never alone. A closed document says
      // "this closure happened". One that could be created without the schedule write it
      // belongs to is a closure the account does not know about - a man shown as paid
      // from a record nothing applied. So it is creatable only in the commit that leaves
      // the schedule pointing at this operation, at this revision, written by a build
      // that speaks protocol 2.
      match /closed/{entryId} {
        allow read: if allowed();
        allow create: if allowed()
          && request.resource.data.opId is string
          && request.resource.data.opId.size() > 0
          && request.resource.data.opId.size() < 128
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && closedMatchesSchedule(docId);
        allow update, delete: if false;
      }

      // THE MONTHS THAT HAVE LEFT: one document per archived month, created once.
      //
      // Named by its content - {YYYY-MM}_{digest of its days} - so a copy made before a
      // late edit to that month is simply a document nothing points at, and never a
      // name the true copy can no longer take. CREATE only, like a closed document, and
      // NEVER ALONE for the same reason: creatable only in the commit that takes the
      // schedule to the revision it names, pointing at the operation it names, written
      // by a build that speaks protocol 2. Every day it holds must be one of the dates
      // it lists - the dates are what the schedule will refuse writes to.
      match /months/{monthId} {
        allow read: if allowed();
        allow create: if allowed()
          && request.resource.data.opId is string
          && request.resource.data.opId.size() > 0
          && request.resource.data.opId.size() < 128
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.digest is string
          && monthId == request.resource.data.month + '_' + request.resource.data.digest
          && request.resource.data.days is map
          && request.resource.data.days.size() > 0
          && request.resource.data.dates is list
          && request.resource.data.dates.size() >= 28
          && request.resource.data.dates.size() <= 31
          && request.resource.data.dates.toSet().hasAll(request.resource.data.days.keys())
          && closedMatchesSchedule(docId);
        allow update, delete: if false;
      }

      // WHICH RULES ARE THESE? (Phase 8) Nothing is ever stored here. The app reads
      // probe/paybook-8 before it turns the pay book on for a record: under these rules
      // the read is allowed (and finds nothing), and under every set of rules published
      // before them it is refused, because they have no such block. So a phone can tell
      // "the new rules are live" from "they are not" without writing anything. The name
      // moves when the rules a client must not run without move - never otherwise.
      match /probe/{generation} {
        allow get: if allowed() && generation == 'paybook-8';
        allow list, create, update, delete: if false;
      }
    }

    // (The block that says WHICH rules these are is inside match /schedules above.)

    // One copy of the schedule per day, and the reason sync is not the same thing as a
    // backup. Everything above is a mirror: a deletion propagates to all three phones as
    // faithfully as a correction does, and by the time it is noticed everyone agrees
    // with it.
    //
    // CREATE only. Not update - so a day's copy can never be overwritten by a later,
    // already-damaged state. Not delete - so nothing here can be lost to a careless tap
    // or a bug in the client, which is exactly what a backup has to promise. Enforced on
    // the server, so no version of the app can break it.
    match /history/{day} {
      allow read, create: if allowed();
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
