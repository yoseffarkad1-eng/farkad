rules_version = '2';

// The real access control for this app. The web config in js/sync/firebase-config.js is
// public and protects nothing; these rules are enforced on the server and are the only
// thing standing between the schedule and anyone who finds the URL.
//
// Everyone listed writes. The evening roster is built by the three of them together and
// they divide the work between themselves, so there is deliberately no reader/writer
// split here - the protection against overwriting each other is technical, not a
// permission: the client sends one field path per edit, never the whole document.
//
// Deployment: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Put the real addresses here. Anyone not listed is refused even with a valid Google
    // account - public sign-up is closed on purpose.
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        'yosef.farkad1@gmail.com',
        'farkad1963@gmail.com',
        'mu.mahameed1992@gmail.com'
        // A fourth goes here the same way: comma on the line above, address below, then
        // Publish in the console. Lower case - the token's email arrives lower-cased and
        // an address with a capital in it would match nobody.
      ];
    }

    // Guards the shape of a full replacement (import, backup restore). A field-level
    // edit is exempt because it carries only the one path it changed - requiring the top
    // level keys there would reject every normal write.
    function fullDocumentOk() {
      return request.resource.data.keys().hasAll(['workers', 'places', 'updatedAt'])
        && request.resource.data.workers is list
        && request.resource.data.places is list;
    }

    function isFullReplacement() {
      return request.resource.data.keys().hasAny(['workers', 'places']);
    }

    // Every write must carry a timestamp: the client's merge rule depends on it, and a
    // write without one would make the document look older than it is.
    function stamped() {
      return request.resource.data.updatedAt is string;
    }

    // ---------------------------------------------------------------- the ordering
    //
    // Three phones share this document. Firestore merges disjoint field paths server-side,
    // which is what lets two people fill in the same evening at once - but everything that
    // is NOT a disjoint merge had no ordering at all: a restore raced an edit and the loser
    // was silent, a stale writer overwrote a newer document, and a request that might still
    // land was treated as dead and sent twice.
    //
    // The client's send claim cannot fix that. It is a lease in localStorage: it
    // coordinates tabs of one browser profile, and the three phones share no storage. The
    // only party all three can agree with is this file.
    //
    // Three fields carry it, and none of them is a clock. updatedAt stays exactly what it
    // was - a phone's own time, informational, never load-bearing.

    // The version of the protocol the writer speaks.
    //
    // This is the backward-compatibility decision, stated rather than finessed: a build
    // that predates the protocol writes no such field, and there is no rule that both
    // accepts those writes and orders them - accepting them once the document is ordered
    // IS the hole. So after cutover it is refused, the old build shows a visible sync
    // error, keeps its queue, does not say synced, and cannot diverge quietly.
    //
    // Cutover is not a date somebody picks. It is the first protocol write landing on the
    // document; until then legacyWrite() below keeps the un-updated phone working. That is
    // what makes the rollout executable rather than a sentence. See docs/sync-protocol.md.
    function versioned() {
      return request.resource.data.protocol is int
        && request.resource.data.protocol >= 1;
    }

    // The compare-and-set. Exactly one more than what is there.
    //
    // Two phones that both read revision 5 both try to write 6. The first lands; for the
    // second, the document now says 6, its write still says 6, and 6 is not 6 + 1 - so it
    // is refused instead of silently overwriting work that is already there. The client
    // turns that refusal into a held conflict rather than a retry that would overwrite.
    function nextRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
    }

    function firstRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == 1;
    }

    // THE DOCUMENT THAT IS ALREADY THERE, and has never spoken the protocol.
    //
    // The live schedule was written by builds that had never heard of a revision. It has
    // a roster, days and advances and no `revision` field at all - so nextRevision()
    // asks it for `null + 1` and refuses, for ever. Without an exception the existing
    // document could never take its first protocol write, and the rollout is a paragraph
    // that cannot be executed.
    function noRevisionYet() {
      return !('revision' in resource.data);
    }

    // The exception is exactly one write wide. It applies only while the document has no
    // revision; the moment one lands, noRevisionYet() is false and nextRevision() governs
    // everything after. A later write claiming revision 1 over a document already at 7 is
    // refused by both halves, so this cannot be reused to reset the count.
    function bootstrapRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == 1;
    }

    // A WRITE FROM A PHONE THAT HAS NOT UPDATED YET.
    //
    // This is what makes the rollout executable rather than a sequencing puzzle with no
    // valid order. Publishing rules that demand a protocol breaks every phone in the
    // field the same minute; waiting until every phone has updated means the updated ones
    // cannot write in the meantime, because the published rules have no receipts
    // subcollection. Neither order works.
    //
    // So during the transition both shapes are allowed - and only until the document is
    // bootstrapped. Once it carries a revision, a write with no protocol is refused, so
    // an old phone cannot flatten the ordering fields after cutover. That is the whole
    // rollout: publish this, let the phones update, and the first protocol-capable write
    // closes the door behind itself.
    function legacyWrite() {
      return noRevisionYet() && !('protocol' in request.resource.data);
    }

    // The operation this write carries, and its receipt - which must exist AFTER this
    // commit. getAfter() is the whole of the atomicity guarantee: the rule can only be
    // satisfied if the document and the receipt land together, so a reader never sees a
    // revision without the receipt that explains it, or a receipt for a revision that was
    // never applied.
    //
    // The receipt is also what makes a retry safe. A request that may still land can be
    // sent again, because the second attempt finds its own receipt and stops - which is
    // the difference between "sent twice" and "acknowledged once".
    function carriesReceipt(docId) {
      return request.resource.data.lastOpId is string
        && request.resource.data.lastOpId.size() > 0
        && request.resource.data.lastOpId.size() < 128
        && getAfter(/databases/$(database)/documents/schedules/$(docId)/receipts/$(request.resource.data.lastOpId)).data.revision
             == request.resource.data.revision;
    }

    match /schedules/{docId} {
      allow read: if allowed();

      allow create: if allowed()
        && stamped()
        && versioned()
        && firstRevision()
        && carriesReceipt(docId)
        && (!isFullReplacement() || fullDocumentOk());

      allow update: if allowed()
        && stamped()
        && (
          // A protocol write: the ordinary next revision, or the one bootstrap that
          // brings a legacy document into the protocol. Either way it carries its
          // receipt, so a revision never exists without the operation that explains it.
          (versioned() && (nextRevision() || (noRevisionYet() && bootstrapRevision()))
            && carriesReceipt(docId))
          // Or a phone that has not updated yet, while the document is still legacy.
          || legacyWrite()
        )
        && (!isFullReplacement() || fullDocumentOk());

      // Nothing deletes the schedule. It is the record of who worked where.
      allow delete: if false;

      // The receipts. Created with the write they belong to, and then frozen.
      //
      // Immutable on purpose: a receipt that could be changed or removed is a receipt that
      // cannot answer "did my operation already land", which is the one question a retry
      // has to ask. Readable, because that is how the retry asks it.
      match /receipts/{opId} {
        allow read: if allowed();
        allow create: if allowed()
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1;
        allow update, delete: if false;
      }
    }

    // One copy of the schedule per day, and the reason sync is not the same thing as a
    // backup. Everything above is a mirror: a deletion propagates to all three phones as
    // faithfully as a correction does, and by the time it is noticed everyone agrees
    // with it.
    //
    // CREATE only. Not update - so a day's copy can never be overwritten by a later,
    // already-damaged state. Not delete - so nothing here can be lost to a careless tap
    // or a bug in the client, which is exactly what a backup has to promise. Enforced on
    // the server, so no version of the app can break it.
    match /history/{day} {
      allow read, create: if allowed();
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
