{
  "name": "farkad",
  "version": "0.0.0",
  "private": true,
  "description": "Day and pay record for a construction crew. A PWA of classic scripts with no build step - this file exists so the tests can be run, not to introduce one.",
  "type": "module",
  "scripts": {
    "test": "npm run test:build && npm run test:data",
    "test:build": "node tests/build.test.mjs",
    "test:data": "node tests/data.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/rules.test.mjs\"",
    "serve": "python3 -m http.server 8802",
    "shot": "node tests/shot.mjs",
    "browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.29.1",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20.11 <23"
  }
}
